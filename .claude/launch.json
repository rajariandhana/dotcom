{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}